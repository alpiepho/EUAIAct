# Configuration for EU AI Act Chat Assistant

# OpenAI Configuration (optional)
# If you have an OpenAI API key, set it here to use OpenAI's models
# If not set or set to 'default', the app will use Ollama instead
OPENAI_API_KEY=sk-123...

# Ollama Configuration (used when OpenAI is not configured)
# The host where your Ollama instance is running
OLLAMA_HOST=<ollama address>:11434

# The Ollama model to use (e.g., llama3.2, mistral, qwen2.5, etc.)
OLLAMA_MODEL=llama3.2

# PDF Configuration
# The PDF file to use for the RAG system (default: EU_AI_Act.pdf)
# The UI will dynamically adapt based on the filename and content
PDF_FILENAME=EU_AI_Act.pdf
